---
// Página de un proyecto. La usan /proyectos/[slug] y /en/proyectos/[slug]:
// la PÁGINA busca el proyecto (y si no existe hace rewrite a la 404),
// esta vista solo lo dibuja en el idioma de la URL.
import BaseLayout from "../layouts/BaseLayout.astro";
import Tag from "../components/Tag.astro";
import Icono from "../components/Icono.astro";
import ContainerScroll from "../components/nular/ContainerScroll.astro";
import TracingBeam from "../components/nular/TracingBeam.astro";
import Carousel from "../components/nular/Carousel.astro";
import type { Proyecto } from "../lib/db/schema";
import { formatearFecha, markdownAHtml, conPunto } from "../lib/proyectos";
import { idiomaDe, traductor, traducido, ruta } from "../i18n";

interface Props {
	proyecto: Proyecto;
}

const { proyecto } = Astro.props;
const idioma = idiomaDe(Astro.currentLocale);
const t = traductor(idioma);

const { slug, titulo, fecha, tecnologias, portada, galeria, repo, demo } = proyecto;
// Contenido en inglés si existe y estamos en /en; si no, el español
const resumen = traducido(idioma, proyecto.resumen, proyecto.resumenEn);
const logros = traducido(idioma, proyecto.logros, proyecto.logrosEn);
const markdown = traducido(idioma, proyecto.contenido, proyecto.contenidoEn);
const html = markdown.trim() ? markdownAHtml(markdown) : "";
---

<BaseLayout title={titulo} description={resumen} tipo="article" imagen={`/og/proyectos/${slug}.jpg`}>
	<a href={ruta(idioma, "/proyectos")} class="inline-flex items-center gap-1 pt-12 text-sm text-tenue transition-colors hover:text-texto">
		<Icono nombre="lucide:arrow-left" class="size-4" />
		{t("proyecto.volver")}
	</a>

	<header class="mt-6">
		<p class="text-sm text-tenue">{formatearFecha(fecha, idioma)}</p>
		<h1 class="mt-2 text-5xl font-extrabold sm:text-6xl" transition:name={`titulo-${slug}`}>{conPunto(titulo)}</h1>
		<p class="mt-4 max-w-2xl text-lg text-tenue">{resumen}</p>

		<div class="mt-6 flex flex-wrap gap-2">
			{tecnologias.map((tec) => <Tag texto={tec} conNombre />)}
		</div>

		{
			logros.length > 0 && (
				<ul class="mt-4 flex flex-wrap gap-2">
					{logros.map((logro) => (
						<li class="rounded-full border border-tenue/50 px-3 py-1 text-sm italic">{logro}</li>
					))}
				</ul>
			)
		}

		<!-- Solo mostramos cada botón si el proyecto tiene ese link -->
		{
			(repo || demo) && (
				<div class="mt-8 flex flex-wrap gap-3 text-sm">
					{demo && (
						<a href={demo} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 rounded-full bg-texto px-4 py-2 font-medium text-fondo transition hover:opacity-80">
							{t("proyecto.enVivo")}
							<Icono nombre="lucide:arrow-up-right" class="size-4" />
						</a>
					)}
					{repo && (
						<a href={repo} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 rounded-full border border-borde px-4 py-2 transition hover:border-texto">
							<Icono nombre="lucide:github" class="size-4" />
							{t("proyecto.codigo")}
						</a>
					)}
				</div>
			)
		}
	</header>

	<!-- La captura en el marco de nularUI (Container Scroll): entra inclinada y se
	     endereza mientras haces scroll. transition:name: "vuela" desde la tarjeta -->
	{
		portada && (
			<ContainerScroll class="mt-10">
				<img src={portada} alt={`${t("proyecto.captura")} ${titulo}`} transition:name={`portada-${slug}`} />
			</ContainerScroll>
		)
	}

	<!-- El contenido (Markdown), con el Tracing Beam de nularUI al costado.
	     set:html inserta el HTML ya convertido. dark:prose-invert: texto claro solo en oscuro -->
	{
		html && (
			<div class="mt-12 pl-6 md:pl-20">
				<TracingBeam>
					<article class="prose prose-lg dark:prose-invert max-w-none pl-10 md:pl-0 prose-a:text-texto prose-a:underline-offset-4" set:html={html} />
				</TracingBeam>
			</div>
		)
	}

	<!-- Galería (Carousel de nularUI): solo si subiste imágenes. Si no, no aparece nada -->
	{
		galeria.length > 0 && (
			<section class="mt-20">
				<h2 class="mb-8 flex items-center gap-4 text-4xl">
					{t("proyecto.galeria")}
					<span class="h-px w-24 bg-borde" />
				</h2>
				<Carousel
					imagenes={galeria.map((src, i) => ({ src, alt: `${titulo}: ${t("proyecto.imagen").toLowerCase()} ${i + 1}` }))}
					textos={{ region: t("carrusel.region"), anterior: t("carrusel.anterior"), siguiente: t("carrusel.siguiente"), de: t("proyectos.de") }}
				/>
			</section>
		)
	}
</BaseLayout>
