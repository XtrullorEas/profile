---
import BaseLayout from "../layouts/BaseLayout.astro";
import Tag from "../components/Tag.astro";

const title = "Sobre mí";
const description = "Conoce más sobre mí, mi experiencia y habilidades.";
const hobbies = ["Programación", "Videojuegos", "Música", "Cine", "Deportes"];
---

<BaseLayout title={title} description={description}>
	<h1 class="text-4xl font-bold tracking-tight">Sobre mí</h1>

	<!-- space-y-4: separa verticalmente cada hijo directo (los <p>) -->
	<div class="mt-6 space-y-4 text-lg leading-relaxed text-tenue">
		<p>
			¡Hola! Soy Elías, un apasionado desarrollador web con experiencia en diversas tecnologías y un
			fuerte interés en la creación de soluciones digitales innovadoras.
		</p>
		<p>
			Actualmente, estoy trabajando en varios proyectos personales y colaborando con otros
			desarrolladores para mejorar mis habilidades y contribuir a la comunidad tecnológica.
		</p>
	</div>

	<h2 class="mb-4 mt-12 text-sm font-semibold uppercase tracking-wider text-tenue">Hobbies</h2>
	<div class="flex flex-wrap gap-2">
		{hobbies.map((hobby) => <Tag texto={hobby} />)}
	</div>

	<p class="mt-12 text-tenue">
		Gracias por visitar mi portfolio. ¡Espero que disfrutes explorando mi trabajo!
	</p>
</BaseLayout>
