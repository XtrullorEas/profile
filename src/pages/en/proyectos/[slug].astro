---
// /en/proyectos/[slug] (inglés). Igual que src/pages/proyectos/[slug].astro.
export const prerender = false;

import Proyecto from "../../../vistas/Proyecto.astro";
import { getProyectoPorSlug } from "../../../lib/proyectos";

const { slug } = Astro.params;
const proyecto = slug ? await getProyectoPorSlug(slug) : undefined;
if (!proyecto) return Astro.rewrite("/en/404");
---

<Proyecto proyecto={proyecto} />
