---
// RUTA DINÁMICA BAJO DEMANDA
// Antes (Fase 3): getStaticPaths generaba un HTML por proyecto durante el build.
// Ahora: no hay lista previa. En CADA visita, Astro toma el [slug] de la URL,
// consulta la base de datos y genera la página en ese momento.
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import Tag from "../../components/Tag.astro";
import { getProyectoPorSlug, formatearFecha, markdownAHtml } from "../../lib/proyectos";

// Astro.params contiene los segmentos dinámicos de la URL:
//   /proyectos/the-myoopy-bar  →  Astro.params.slug === "the-myoopy-bar"
const { slug } = Astro.params;
const proyecto = slug ? await getProyectoPorSlug(slug) : undefined;

// Si no existe (o es borrador), mostramos la página 404 con su código HTTP correcto.
// rewrite() renderiza otra página SIN cambiar la URL del navegador.
if (!proyecto) {
	return Astro.rewrite("/404");
}

const { titulo, resumen, fecha, tecnologias, portada, repo, demo, contenido } = proyecto;
const html = markdownAHtml(contenido);
---

<BaseLayout title={titulo} description={resumen}>
	<a href="/proyectos" class="text-sm text-tenue transition-colors hover:text-texto">
		← Todos los proyectos
	</a>

	<header class="mt-6">
		<p class="text-sm text-tenue">{formatearFecha(fecha)}</p>
		<h1 class="mt-1 text-4xl font-bold tracking-tight">{titulo}</h1>
		<p class="mt-3 text-lg text-tenue">{resumen}</p>

		<div class="mt-4 flex flex-wrap gap-2">
			{tecnologias.map((tec) => <Tag texto={tec} />)}
		</div>

		<!-- Solo mostramos cada botón si el proyecto tiene ese link -->
		{
			(repo || demo) && (
				<div class="mt-6 flex gap-3">
					{demo && (
						<a
							href={demo}
							target="_blank"
							rel="noopener"
							class="rounded-lg bg-acento px-4 py-2 text-sm font-medium text-white transition hover:opacity-90"
						>
							Ver demo ↗
						</a>
					)}
					{repo && (
						<a
							href={repo}
							target="_blank"
							rel="noopener"
							class="rounded-lg border border-borde px-4 py-2 text-sm font-medium transition hover:border-acento/60"
						>
							Código ↗
						</a>
					)}
				</div>
			)
		}
	</header>

	{
		portada && (
			<img
				src={portada}
				alt={`Portada de ${titulo}`}
				class="mt-10 aspect-video w-full rounded-xl border border-borde object-cover"
			/>
		)
	}

	<!-- set:html inserta HTML "crudo". Por defecto Astro ESCAPA todo lo que pones
	     entre {llaves} (para evitar inyecciones); set:html es la forma explícita de
	     decir "esto ya es HTML, confío en él". -->
	<article class="prose prose-invert mt-10 max-w-none prose-a:text-acento" set:html={html} />
</BaseLayout>
