---
// RUTA DINÁMICA BAJO DEMANDA: /proyectos/the-myoopy-bar
// En cada visita, Astro toma el [slug] de la URL y busca el proyecto en la BD.
// La versión en inglés (/en/proyectos/[slug]) hace exactamente lo mismo.
export const prerender = false;

import Proyecto from "../../vistas/Proyecto.astro";
import { getProyectoPorSlug } from "../../lib/proyectos";

const { slug } = Astro.params;
const proyecto = slug ? await getProyectoPorSlug(slug) : undefined;

// Si no existe (o es borrador): la página 404, con su código HTTP correcto.
// rewrite() renderiza otra página SIN cambiar la URL del navegador.
// Va aquí (en la página) y no en la vista: solo una página puede devolver un rewrite.
if (!proyecto) return Astro.rewrite("/404");
---

<Proyecto proyecto={proyecto} />
