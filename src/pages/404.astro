---
// src/pages/404.astro es especial: Astro la usa para cualquier URL que no exista,
// y cuando hacemos Astro.rewrite("/404"). Si la URL que no existe empieza por /en,
// se muestra en inglés. (Las páginas en inglés hacen rewrite a /en/404.)
//
// prerender = false porque Astro NO permite hacer rewrite desde una página
// bajo demanda ([slug].astro) hacia una página estática.
export const prerender = false;
import NoEncontrado from "../vistas/NoEncontrado.astro";

const idioma = /^\/en(\/|$)/.test(Astro.url.pathname) ? "en" : "es";
---

<NoEncontrado idioma={idioma} />
