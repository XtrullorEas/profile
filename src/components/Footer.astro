---
interface Props {
	nombre: string;
	texto: string; // "Hecho con Astro..." en el idioma de la página
}

const { nombre, texto } = Astro.props;
const anio = new Date().getFullYear();
---

<footer class="mx-auto w-full max-w-5xl border-t border-borde px-4 py-8 text-sm text-tenue">
	© {anio} {nombre}. {texto}
</footer>
