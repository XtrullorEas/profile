---
// El tipo Proyecto sale directamente de la tabla (schema.ts).
// Si añades una columna, este tipo la incluye solo.
import type { Proyecto } from "../lib/db/schema";
import Tag from "./Tag.astro";
import { formatearFecha } from "../lib/proyectos";

interface Props {
	proyecto: Proyecto;
}

const { proyecto } = Astro.props;
const { slug, titulo, resumen, fecha, tecnologias, portada } = proyecto;
---

<!-- group: permite que los hijos reaccionen al hover de la tarjeta (group-hover:) -->
<a
	href={`/proyectos/${slug}`}
	class="group block overflow-hidden rounded-xl border border-borde bg-superficie transition hover:-translate-y-1 hover:border-acento/60"
>
	{
		// Las portadas ahora son archivos subidos desde el admin (Fase 4.5),
		// por eso usamos <img> normal: <Image> de astro:assets optimiza en el build,
		// y estas imágenes no existen en el build. Las optimizaremos al subirlas.
		portada && (
			<img
				src={portada}
				alt={`Portada de ${titulo}`}
				loading="lazy"
				class="aspect-video w-full object-cover"
			/>
		)
	}

	<div class="p-5">
		<p class="text-xs text-tenue">{formatearFecha(fecha)}</p>
		<h3 class="mt-1 text-lg font-semibold transition-colors group-hover:text-acento">
			{titulo}
		</h3>
		<p class="mt-2 text-sm text-tenue">{resumen}</p>

		<div class="mt-4 flex flex-wrap gap-2">
			{tecnologias.map((tec) => <Tag texto={tec} />)}
		</div>
	</div>
</a>
