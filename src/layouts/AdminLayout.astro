---
// Layout del panel: distinto al del sitio público (sin Header/Footer del portfolio).
import "../styles/global.css";
import { Font } from "astro:assets";

interface Props {
	title: string;
}

const { title } = Astro.props;
// El middleware dejó aquí el usuario logueado (undefined en la página de login)
const { usuario } = Astro.locals;
---

<!-- El panel siempre en oscuro -->
<html lang="es" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<!-- Carga la fuente de títulos. preload: el navegador la pide antes, sin "parpadeo" -->
		<Font cssVariable="--font-outfit" preload />
		<meta name="viewport" content="width=device-width" />
		<meta name="robots" content="noindex" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title} | Admin</title>
	</head>
	<body class="min-h-screen">
		{
			usuario && (
				<header class="border-b border-borde bg-superficie">
					<nav class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3 text-sm">
						<div class="flex items-center gap-6">
							<a href="/admin" class="font-bold">
								Admin<span class="text-acento">.</span>
							</a>
							<a href="/admin" class="text-tenue hover:text-texto">Proyectos</a>
							<a href="/admin/experiencia" class="text-tenue hover:text-texto">Experiencia</a>
							<a href="/admin/perfil" class="text-tenue hover:text-texto">Perfil</a>
							<a href="/" target="_blank" class="text-tenue hover:text-texto">
								Ver sitio ↗
							</a>
						</div>

						<div class="flex items-center gap-4">
							<span class="text-tenue">{usuario}</span>
							{/* Cerrar sesión con POST (no un link GET): así ningún sitio externo
							    puede cerrarte la sesión con una simple imagen o enlace */}
							<form method="post" action="/admin/logout">
								<button class="rounded-md border border-borde px-3 py-1.5 hover:border-acento/60">
									Cerrar sesión
								</button>
							</form>
						</div>
					</nav>
				</header>
			)
		}

		<main class="mx-auto max-w-5xl px-4 py-10">
			<slot />
		</main>
	</body>
</html>

<script>
	// Vista previa de imágenes para TODO el admin: al elegir un archivo en
	// <input type="file" name="logo">, se muestra en <img data-preview="logo">.
	// Un solo listener en document ("delegación") sirve para cualquier formulario.
	document.addEventListener("change", (e) => {
		const input = e.target;
		if (!(input instanceof HTMLInputElement) || input.type !== "file") return;
		const img = document.querySelector<HTMLImageElement>(`img[data-preview="${input.name}"]`);
		const archivo = input.files?.[0];
		if (!img || !archivo) return;
		URL.revokeObjectURL(img.src); // libera la vista previa anterior (si era una)
		img.src = URL.createObjectURL(archivo); // URL temporal al archivo de tu disco
		img.hidden = false;
	});
</script>
